---
import Base from "../layouts/Base.astro";

type Paper = {
  no: string;
  status: string;
  title: string;
  authors: string;
  abstract: string;
  repo?: string;
};

const underReview: Paper[] = [
  {
    no: "01",
    status: "AAAI 2027 · under review",
    title:
      "Building the Off-Switch: The Three Gates of Pausing a Multi-Principal Agent System",
    authors: "Shuo Li Liu, Xuanyi Wang, Haochen Wen",
    abstract:
      "When developers, operators, platform owners, and regulators jointly oversee a population of interacting agents, none of them holds enough information to decide a shutdown alone. This paper gives the first complete formal treatment of distributed shutdown authority. Pausing decomposes into three necessary gates: detection, attribution, and intervention. Every observed safety failure maps onto exactly one failing gate, and we prove conditional lower bounds on what each principal must know for a legitimate pause decision to exist.",
    repo: "https://github.com/Triciaaaaa/three-gates",
  },
  {
    no: "02",
    status: "AAAI 2027 · under review",
    title: "In the Stream: Agent Memory for the Big World",
    authors: "Xuanyi Wang, Shuo Li Liu, Haochen Wen",
    abstract:
      "Agent memory usually means one of two extremes: consolidate experience into model weights, which is slow and destructive, or keep an ever-growing external store, which is cheap to write and hard to keep predictive. We develop a third path from the online-learning literature. Maintain many local predictive models, update all of them as the stream arrives, and at each decision point act on whichever currently predicts best. On MemoryAgentBench this reaches 90.0, above all published systems.",
    repo: "https://github.com/Triciaaaaa/stream-memory",
  },
  {
    no: "03",
    status: "AAAI 2027 · under review",
    title: "Convergence Is Open: What Are Representations Converging Toward?",
    authors: "Xuanyi Wang, Shuo Li Liu, Haochen Wen",
    abstract:
      "The platonic-representation literature reads growing cross-model and cross-modal similarity as evidence that models approach a shared statistical model of reality. We examine the measurement itself. The directional statistics behind claims of convergence toward the world, or toward language, are not invariant under invertible reparameterizations of the representation space. The same system can yield either reading under a coordinate change that alters nothing observable. The direction of convergence remains open.",
    repo: "https://github.com/Triciaaaaa/convergence-open",
  },
  {
    no: "04",
    status: "AAAI 2027 · under review",
    title:
      "Reduced Hostility Increases Simulated Existential Risk Through Race Synchronization",
    authors: "Shuo Li Liu, Xuanyi Wang, Haochen Wen",
    abstract:
      "Intuition says that making AI developers less hostile to each other should make the world safer. We test this in the largest published AI-race simulation: about 10K game runs and 9.7M trajectory evaluations of firms choosing between capability racing and safety investment. Reducing hostility synchronizes competitors' schedules, safety-oriented agents lose the capability frontier, and simulated existential risk rises.",
    repo: "https://github.com/Triciaaaaa/race-sync-sim",
  },
];

const working: Paper[] = [
  {
    no: "05",
    status: "working paper · target AAAI 2027 alignment track",
    title: "The Formal Limitations of an Artificial Intelligence Constitution",
    authors: "Xuanyi Wang, Shuo Li Liu",
    abstract:
      "Encoding AI goals as constitutional principles is an aggregation problem, and aggregation has known impossibility results. This paper gives the first application of Gibbard-Satterthwaite to constitutional AI design: aggregated principles inherit conflict from social choice and face underdetermination at once. Both failure modes are quantified by simulation.",
  },
  {
    no: "06",
    status: "in progress · pre-registered · target ICLR 2027",
    title: "Does General Intelligence Specialize?",
    authors: "SWARM study",
    abstract:
      "A pre-registered 1,000-agent LLM swarm with citation-based survival, active elimination, and covert adversarial agents. Over $50K of API compute committed. Early findings: enforcement fails silently under illusory selection pressure, and collective-welfare behavior emerges unprompted.",
    repo: "https://github.com/Triciaaaaa/swarm-preregistration",
  },
  {
    no: "07",
    status: "in progress · target ICLR 2027",
    title:
      "Provers Game the Spec: Verifiable Measurement of Specification Gaming in Formal Theorem Proving",
    authors: "—",
    abstract:
      "The first per-proof, machine-checkable gaming criterion (replay-transfer), and the first capability-controlled base-vs-RL measurement of specification exploitation in a domain with exact ground truth (Lean 4). Hypotheses, kill-gates, and stop-loss rules were fixed before execution.",
  },
  {
    no: "08",
    status: "in progress · economics arm executed aug 2026",
    title:
      "One-Day AI4Science: A 100-Billion-Token Campaign on Forty Open Theory Problems",
    authors: "—",
    abstract:
      "Forty curated frontiers across economics, physics, and chemistry theory, each with a frozen micro-conjecture and a mechanical verifier. Fail-closed by construction: two independent verification paths per claim, clean-room replication, and a pipeline that never says solved. Results are under expert review.",
    repo: "https://github.com/Triciaaaaa/ai4sci-one-day",
  },
  {
    no: "09",
    status: "manuscript in preparation",
    title: "The Political Theology of AGI",
    authors: "long-form essay & research programme",
    abstract:
      "Agent societies are a structural recurrence of pre-modern political forms, and safety frameworks misread them by treating agents as instruments instead of participants. Three open problems connect the formal work above to Schmitt, Hobbes, and social choice. The programme note is on the blog. The long essay is in preparation.",
  },
];
---

<Base
  title="Research"
  description="Papers and abstracts from the programme: four under review at AAAI 2027, the rest in progress."
>
  <div class="wrap">
    <header class="page-head">
      <span class="micro micro--accent">Research</span>
      <h1>Papers &amp; Abstracts</h1>
      <p>
        Four papers under review, the rest in progress. Code and frozen
        artifacts for each are public.
      </p>
    </header>

    <div class="index-head">
      <h2>Under review</h2>
      <span class="micro">AAAI 2027</span>
    </div>
    {underReview.map((p) => (
      <article class="paper">
        <span class="paper__no">{p.no}</span>
        <div class="paper__body">
          <h3>{p.title}</h3>
          <p class="paper__authors">{p.authors}</p>
          <p class="paper__abstract">{p.abstract}</p>
          {p.repo && (
            <a class="paper__link" href={p.repo}>
              {p.repo.replace("https://", "")} →
            </a>
          )}
        </div>
      </article>
    ))}

    <div class="index-head">
      <h2>Working &amp; in progress</h2>
      <span class="micro">since 2026</span>
    </div>
    {working.map((p) => (
      <article class="paper">
        <span class="paper__no">{p.no}</span>
        <div class="paper__body">
          <span class="micro">{p.status}</span>
          <h3>{p.title}</h3>
          {p.authors !== "—" && <p class="paper__authors">{p.authors}</p>}
          <p class="paper__abstract">{p.abstract}</p>
          {p.repo && (
            <a class="paper__link" href={p.repo}>
              {p.repo.replace("https://", "")} →
            </a>
          )}
        </div>
      </article>
    ))}

    <div class="index-head">
      <h2>Book</h2>
      <span class="micro">print</span>
    </div>
    <article class="paper">
      <span class="paper__no">×</span>
      <div class="paper__body">
        <span class="micro">Peking University Press · 2023</span>
        <h3>Humans, Ethics, Machines（人、伦理、机器人）</h3>
        <p class="paper__abstract">
          Contributing author. Grew out of AI-ethics research at Microsoft
          Research Asia.
        </p>
      </div>
    </article>
  </div>
</Base>
