---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}.${String(d.getDate()).padStart(2, "0")}`;
---

<Base title="Writing" description="All writing on NOMOS.">
  <div class="wrap">
    <header class="page-head">
      <span class="micro micro--accent">Writing · index</span>
      <h1>Writing</h1>
      <p>{posts.length} entries · newest first</p>
    </header>

    <div style="margin-top: 56px; border-top: 1px solid var(--ink);">
      {posts.map((post, i) => (
        <a class="entry" href={`/blog/${post.id}`}>
          <span class="entry__no">{String(posts.length - i).padStart(2, "0")}</span>
          <div>
            <span class="entry__date">{fmt(post.data.date)} · {post.data.tags[0] ?? "essay"}</span>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </div>
          <div class="entry__thumb">
            <span class="stamp stamp--s"><img src={post.data.cover} alt={post.data.coverAlt} /></span>
          </div>
        </a>
      ))}
    </div>
  </div>
</Base>
